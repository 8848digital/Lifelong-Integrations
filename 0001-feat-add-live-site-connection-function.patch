+def live_site_connection():
+	"""Return the live site base URL and auth headers, using the target
+	site URL and API key/secret from Lifelong Settings (same as the
+	Swiggy integration's _get_live_site_connection)."""
+	config = frappe.get_cached_doc("Lifelong Settings")
+	base_url = config.target_site_url.rstrip("/")
+	headers = {
+		"Authorization": (
+			f"token {config.target_site_user_api_key}:"
+			f"{config.get_password('target_site_user_api_secret')}"
+		),
+		"Content-Type": "application/json",
+	}
+	return base_url, headers
+
+
